{
  "name": "@lilo/design-tree-service",
  "version": "0.1.0",
  "private": true,
  "description": "CRUD del árbol de diseño, versionado tipo Git (snapshots) y autosave. Fuente de verdad persistida en PostgreSQL (JSONB).",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "fastify": "latest",
    "pg": "latest",
    "zod": "latest",
    "@lilo/design-schema": "*"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.7.0"
  }
}
