{
  "name": "@lilo/collaboration-service",
  "version": "0.1.0",
  "private": true,
  "description": "Edición simultánea multi-usuario (CRDT/Yjs), presencia en vivo y comentarios anclados a elementos del diseño.",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "ws": "latest",
    "yjs": "latest",
    "y-protocols": "latest",
    "lib0": "latest",
    "fastify": "latest",
    "@lilo/design-schema": "*",
    "@lilo/collab-schema": "*"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.7.0"
  }
}
